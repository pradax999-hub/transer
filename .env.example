# Wayro Backend Configuration
PORT=3000
CLIENT_URL=http://localhost:3000

# Stripe Payment Gateway (sk_live_... для реальних платежів, sk_test_... для тесту)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email Configuration (SMTP для відправки підтверджень клієнтам)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM="Wayro Transfer <noreply@wayro.cz>"

# Driver Tracking (координати від драйвер-додатку)
DRIVER_UPDATE_INTERVAL_MS=3000
